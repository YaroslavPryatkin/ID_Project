-- ==========================================
-- INSERTERS (insert_functions_noout_)
-- ==========================================

CREATE OR REPLACE FUNCTION insert_functions_noout_countries(p_name VARCHAR, p_continent CONTINENT) RETURNS void AS $$
BEGIN
    INSERT INTO countries ("name", "continent") VALUES (p_name, p_continent);
EXCEPTION
    WHEN unique_violation THEN RAISE EXCEPTION 'A country with this name already exists.';
END;
$$ LANGUAGE plpgsql;

CREATE OR REPLACE FUNCTION insert_functions_noout_persons(
    p_first_name VARCHAR, p_last_name VARCHAR, p_date_of_birth DATE, 
    p_gender GENDER, p_country_id INTEGER, p_club_id INTEGER DEFAULT NULL
) RETURNS void AS $$
BEGIN
    INSERT INTO persons ("first_name", "last_name", "date_of_birth", "gender", "country_id", "club_id") 
    VALUES (p_first_name, p_last_name, p_date_of_birth, p_gender, p_country_id, p_club_id);
EXCEPTION
    WHEN foreign_key_violation THEN RAISE EXCEPTION 'The specified country (ID: %) does not exist.', p_country_id;
END;
$$ LANGUAGE plpgsql;

CREATE OR REPLACE FUNCTION insert_functions_noout_person_contact_data(
    p_person_id INTEGER, p_mail_adress TEXT, p_phone_number TEXT, 
    p_timestamp_from DATE, p_timestamp_to DATE DEFAULT NULL
) RETURNS void AS $$
BEGIN
    INSERT INTO person_contact_data ("person_id", "mail_adress", "phone_number", "timestamp_from", "timestamp_to") 
    VALUES (p_person_id, p_mail_adress, p_phone_number, p_timestamp_from, p_timestamp_to);
EXCEPTION
    WHEN foreign_key_violation THEN RAISE EXCEPTION 'Person with ID % not found.', p_person_id;
    WHEN unique_violation THEN RAISE EXCEPTION 'Contact data for this person on this start date already exists.';
END;
$$ LANGUAGE plpgsql;

CREATE OR REPLACE FUNCTION insert_functions_noout_players(p_person_id INTEGER) RETURNS void AS $$
BEGIN
    INSERT INTO players ("person_id") VALUES (p_person_id);
EXCEPTION
    WHEN foreign_key_violation THEN RAISE EXCEPTION 'Person with ID % not found.', p_person_id;
END;
$$ LANGUAGE plpgsql;

CREATE OR REPLACE FUNCTION insert_functions_noout_arbiters(p_person_id INTEGER) RETURNS void AS $$
BEGIN
    INSERT INTO arbiters ("person_id") VALUES (p_person_id);
EXCEPTION
    WHEN foreign_key_violation THEN RAISE EXCEPTION 'Person with ID % not found.', p_person_id;
END;
$$ LANGUAGE plpgsql;

CREATE OR REPLACE FUNCTION insert_functions_noout_tournaments(
    p_chess_type_id INTEGER, p_address VARCHAR, p_country_id INTEGER, 
    p_name VARCHAR, p_main_arbiter INTEGER, p_time_control_id INTEGER
) RETURNS void AS $$
BEGIN
    INSERT INTO tournaments ("chess_type_id", "address", "country_id", "name", "main_arbiter", "time_control_id") 
    VALUES (p_chess_type_id, p_address, p_country_id, p_name, p_main_arbiter, p_time_control_id);
EXCEPTION
    WHEN foreign_key_violation THEN RAISE EXCEPTION 'One of the specified IDs (Chess Type, Country, Arbiter, or Time Control) does not exist.';
END;
$$ LANGUAGE plpgsql;

CREATE OR REPLACE FUNCTION insert_functions_noout_chess_type(
    p_name VARCHAR, p_total_time_from INTERVAL DEFAULT NULL, p_total_time_to INTERVAL DEFAULT NULL
) RETURNS void AS $$
BEGIN
    INSERT INTO chess_type ("name", "total_time_from", "total_time_to") 
    VALUES (p_name, p_total_time_from, p_total_time_to);
END;
$$ LANGUAGE plpgsql;

CREATE OR REPLACE FUNCTION insert_functions_noout_games(
    p_tournament_id INTEGER, p_white_player_id INTEGER, p_black_player_id INTEGER, 
    p_result NUMERIC, p_round_number INTEGER, p_pgn TEXT DEFAULT NULL
) RETURNS void AS $$
BEGIN
    IF p_white_player_id = p_black_player_id THEN
        RAISE EXCEPTION 'The same player cannot play both white and black (ID: %).', p_white_player_id;
    END IF;

    INSERT INTO games ("tournament_id", "white_player_id", "black_player_id", "result", "round_number", "pgn") 
    VALUES (p_tournament_id, p_white_player_id, p_black_player_id, p_result, p_round_number, p_pgn);
EXCEPTION
    WHEN foreign_key_violation THEN RAISE EXCEPTION 'The specified tournament or one of the players does not exist.';
    WHEN check_violation THEN RAISE EXCEPTION 'Invalid game result. Allowed values are: 1, 0.5, 0, or NULL.';
END;
$$ LANGUAGE plpgsql;

CREATE OR REPLACE FUNCTION insert_functions_noout_live_rating(
    p_player_id INTEGER, p_chess_type_id INTEGER, p_value NUMERIC
) RETURNS void AS $$
BEGIN
    INSERT INTO live_rating ("player_id", "chess_type_id", "value") 
    VALUES (p_player_id, p_chess_type_id, p_value);
EXCEPTION
    WHEN foreign_key_violation THEN RAISE EXCEPTION 'Player or chess type not found.';
    WHEN unique_violation THEN RAISE EXCEPTION 'Live rating for this player and chess type already exists.';
END;
$$ LANGUAGE plpgsql;

CREATE OR REPLACE FUNCTION insert_functions_noout_rating_history(
    p_player_id INTEGER, p_value INTEGER, p_chess_type_id INTEGER, 
    p_date_from DATE, p_date_to DATE DEFAULT NULL
) RETURNS void AS $$
BEGIN
    INSERT INTO rating_history ("player_id", "value", "chess_type_id", "date_from", "date_to") 
    VALUES (p_player_id, p_value, p_chess_type_id, p_date_from, p_date_to);
EXCEPTION
    WHEN foreign_key_violation THEN RAISE EXCEPTION 'Player or chess type not found.';
    WHEN unique_violation THEN RAISE EXCEPTION 'A history record for this player, chess type, and date already exists.';
END;
$$ LANGUAGE plpgsql;

CREATE OR REPLACE FUNCTION insert_functions_noout_time_controls(
    p_starting_time INTERVAL, p_increment INTERVAL DEFAULT '0 seconds'
) RETURNS void AS $$
BEGIN
    INSERT INTO time_controls ("starting_time", "increment") 
    VALUES (p_starting_time, p_increment);
EXCEPTION
    WHEN unique_violation THEN RAISE EXCEPTION 'This time control already exists.';
END;
$$ LANGUAGE plpgsql;

CREATE OR REPLACE FUNCTION insert_functions_noout_titles(
    p_short_name CHAR, p_full_name VARCHAR
) RETURNS void AS $$
BEGIN
    INSERT INTO titles ("short_name", "full_name") VALUES (p_short_name, p_full_name);
EXCEPTION
    WHEN unique_violation THEN RAISE EXCEPTION 'A title with this short or full name already exists.';
END;
$$ LANGUAGE plpgsql;

CREATE OR REPLACE FUNCTION insert_functions_noout_players_titles(
    p_player_id INTEGER, p_title_short_name CHAR, p_date_achieved DATE, 
    p_norm1_tournament_id INTEGER DEFAULT NULL, p_norm2_tournament_id INTEGER DEFAULT NULL, 
    p_norm3_tournament_id INTEGER DEFAULT NULL, p_rating_norm_date DATE DEFAULT NULL
) RETURNS void AS $$
BEGIN
    INSERT INTO players_titles (
        "player_id", "title_short_name", "date_achieved", 
        "norm1_tournament_id", "norm2_tournament_id", "norm3_tournament_id", "rating_norm_date"
    ) VALUES (
        p_player_id, p_title_short_name, p_date_achieved, 
        p_norm1_tournament_id, p_norm2_tournament_id, p_norm3_tournament_id, p_rating_norm_date
    );
EXCEPTION
    WHEN foreign_key_violation THEN RAISE EXCEPTION 'The specified player, title, or one of the norm tournaments does not exist.';
    WHEN unique_violation THEN RAISE EXCEPTION 'This player already has this title.';
END;
$$ LANGUAGE plpgsql;


-- ==========================================
-- REMOVALS (remove_functions_noout_)
-- ==========================================

CREATE OR REPLACE FUNCTION remove_functions_noout_countries(p_country_id INTEGER) RETURNS void AS $$
BEGIN
    DELETE FROM countries WHERE country_id = p_country_id;
    IF NOT FOUND THEN RAISE EXCEPTION 'Country with ID % not found.', p_country_id; END IF;
EXCEPTION
    WHEN foreign_key_violation THEN RAISE EXCEPTION 'Cannot delete country (ID: %) because it is linked to persons or tournaments.', p_country_id;
END;
$$ LANGUAGE plpgsql;

CREATE OR REPLACE FUNCTION remove_functions_noout_persons(p_person_id INTEGER) RETURNS void AS $$
BEGIN
    DELETE FROM persons WHERE person_id = p_person_id;
    IF NOT FOUND THEN RAISE EXCEPTION 'Person with ID % not found.', p_person_id; END IF;
EXCEPTION
    WHEN foreign_key_violation THEN RAISE EXCEPTION 'Cannot delete person (ID: %) because they are linked to a player, arbiter, or contact data.', p_person_id;
END;
$$ LANGUAGE plpgsql;

CREATE OR REPLACE FUNCTION remove_functions_noout_person_contact_data(p_person_id INTEGER, p_timestamp_from DATE) RETURNS void AS $$
BEGIN
    DELETE FROM person_contact_data WHERE person_id = p_person_id AND timestamp_from = p_timestamp_from;
    IF NOT FOUND THEN RAISE EXCEPTION 'Contact data for person % from date % not found.', p_person_id, p_timestamp_from; END IF;
END;
$$ LANGUAGE plpgsql;

CREATE OR REPLACE FUNCTION remove_functions_noout_players(p_player_id INTEGER) RETURNS void AS $$
BEGIN
