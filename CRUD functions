CREATE OR REPLACE FUNCTION read_functions_countries() RETURNS SETOF countries AS $$ SELECT * FROM countries; $$ LANGUAGE sql;
CREATE OR REPLACE FUNCTION read_functions_persons() RETURNS SETOF persons AS $$ SELECT * FROM persons; $$ LANGUAGE sql;
CREATE OR REPLACE FUNCTION read_functions_person_contact_data() RETURNS SETOF person_contact_data AS $$ SELECT * FROM person_contact_data; $$ LANGUAGE sql;
CREATE OR REPLACE FUNCTION read_functions_players() RETURNS SETOF players AS $$ SELECT * FROM players; $$ LANGUAGE sql;
CREATE OR REPLACE FUNCTION read_functions_arbiters() RETURNS SETOF arbiters AS $$ SELECT * FROM arbiters; $$ LANGUAGE sql;
CREATE OR REPLACE FUNCTION read_functions_tournaments() RETURNS SETOF tournaments AS $$ SELECT * FROM tournaments; $$ LANGUAGE sql;
CREATE OR REPLACE FUNCTION read_functions_chess_type() RETURNS SETOF chess_type AS $$ SELECT * FROM chess_type; $$ LANGUAGE sql;
CREATE OR REPLACE FUNCTION read_functions_games() RETURNS SETOF games AS $$ SELECT * FROM games; $$ LANGUAGE sql;
CREATE OR REPLACE FUNCTION read_functions_live_rating() RETURNS SETOF live_rating AS $$ SELECT * FROM live_rating; $$ LANGUAGE sql;
CREATE OR REPLACE FUNCTION read_functions_rating_history() RETURNS SETOF rating_history AS $$ SELECT * FROM rating_history; $$ LANGUAGE sql;
CREATE OR REPLACE FUNCTION read_functions_time_controls() RETURNS SETOF time_controls AS $$ SELECT * FROM time_controls; $$ LANGUAGE sql;
