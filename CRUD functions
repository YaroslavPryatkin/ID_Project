    IF NOT FOUND THEN RAISE EXCEPTION 'Player with ID % not found.', p_player_id; END IF;
EXCEPTION
    WHEN foreign_key_violation THEN RAISE EXCEPTION 'Cannot delete player (ID: %) because they have games, titles, or a rating history.', p_player_id;
END;
$$ LANGUAGE plpgsql;

CREATE OR REPLACE FUNCTION remove_functions_noout_arbiters(p_arbiter_id INTEGER) RETURNS void AS $$
BEGIN
